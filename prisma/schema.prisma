generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String
  imageName String?  @db.Text
  areas     Area[]
}

model Area {
  id        Int       @id @default(autoincrement())
  name      String
  imageName String?   @db.Text
  cityId    Int
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  projects  Project[]
}

model Project {
  id                 Int      @id @default(autoincrement())
  name               String
  imageName          String?  @db.Text
  areaId             Int?
  area               Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  areaName           String?
  status             String?
  deliveryDate       String?
  aboutProject       String?  @db.Text
  videoURL           String?  @db.Text
  mainImage          String?  @db.Text
  locationImage      String?  @db.Text
  pdfFile            String?  @db.Text
  isFinish           Boolean  @default(false)
  detailsCoverImage  String?  @db.Text
  locationProjects   String?  @db.Text
  advantageProjects  String?  @db.Text
  images             String?  @db.Text
  units              Unit[]
}

model Unit {
  id                 Int      @id @default(autoincrement())
  title              String
  description        String?  @db.Text
  imageName          String?  @db.Text
  status             String   @default("Available")
  isShown            Boolean  @default(true)
  codeUnit           String?
  area               Float    @default(0)
  numberBathroom     Int      @default(0)
  numberRoom         Int      @default(0)
  yearOfBuild        Int      @default(2024)
  price              Float    @default(0)
  videoUrl           String?  @db.Text
  latitude           Float?
  longitude          Float?
  nameLocation       String?
  typePrice          String   @default("كاش")
  projectId          Int?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  detailsCoverImage  String?  @db.Text
  advantageUnits     String?  @db.Text
  serviceUnits       String?  @db.Text
  unitImages         String?  @db.Text
}

model Slider {
  id        Int     @id @default(autoincrement())
  mediaType String  @default("image")
  mediaPath String  @db.Text
  title     String?
  subtitle  String?
  link      String? @db.Text
}

model CoverImage {
  id        Int     @id @default(autoincrement())
  imageName String  @db.Text
  imageType String?
  pageName  String
}

model SocialLink {
  id   Int     @id @default(autoincrement())
  url  String  @db.Text
  type Int
  name String?
}

model WhyUs {
  id              Int     @id @default(autoincrement())
  title           String
  description     String  @db.Text
  quote           String? @db.Text
  fullDescription String? @db.Text
  imageUrl        String? @db.Text
}

model MediaCategory {
  id        Int     @id @default(autoincrement())
  title     String
  imageName String? @db.Text
  media     Media[]
}

model Media {
  id          Int           @id @default(autoincrement())
  title       String
  description String        @db.Text
  created     String?
  imageName   String?       @db.Text
  videoURl    String?       @db.Text
  mediaId     Int
  category    MediaCategory @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model FinishCategory {
  id          Int     @id @default(autoincrement())
  title       String
  imageName   String? @db.Text
  description String? @db.Text
  items       String? @db.Text
}

model CommercialProject {
  id          Int     @id @default(autoincrement())
  title       String
  areaName    String
  description String  @db.Text
  imageName   String? @db.Text
  unitsCount  Int     @default(0)
  type        String  @default("تجاري")
  priceStart  Float   @default(0)
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  project   String?
  message   String?  @db.Text
  createdAt DateTime @default(now())
  status    String   @default("جديد")
  notes     String?  @db.Text
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("SuperAdmin")
}

model LandingPage {
  id                     Int     @id @default(1)
  videoUrl               String? @default("https://www.youtube.com/embed/5oXlbsDoiPE") @db.Text
  projectsCount          Int     @default(68)
  totalUnits             Int     @default(628)
  underConstructionCount Int     @default(90)
  deliveredUnitsCount    Int     @default(528)
}
