generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model City {
  id        Int      @id @default(autoincrement())
  name      String
  imageName String?
  areas     Area[]
}

model Area {
  id        Int       @id @default(autoincrement())
  name      String
  imageName String?
  cityId    Int
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  projects  Project[]
}

model Project {
  id                 Int      @id @default(autoincrement())
  name               String
  imageName          String?
  areaId             Int?
  area               Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  areaName           String?
  status             String?
  deliveryDate       String?
  aboutProject       String?
  videoURL           String?
  mainImage          String?
  locationImage      String?
  pdfFile            String?
  isFinish           Boolean  @default(false)
  detailsCoverImage  String?
  locationProjects   String?
  advantageProjects  String?
  images             String?
  units              Unit[]
}

model Unit {
  id                 Int      @id @default(autoincrement())
  title              String
  description        String?
  imageName          String?
  status             String   @default("Available")
  isShown            Boolean  @default(true)
  codeUnit           String?
  area               Float    @default(0)
  numberBathroom     Int      @default(0)
  numberRoom         Int      @default(0)
  yearOfBuild        Int      @default(2024)
  price              Float    @default(0)
  videoUrl           String?
  latitude           Float?
  longitude          Float?
  nameLocation       String?
  typePrice          String   @default("كاش")
  projectId          Int?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  detailsCoverImage  String?
  advantageUnits     String?
  serviceUnits       String?
  unitImages         String?
}

model Slider {
  id        Int     @id @default(autoincrement())
  mediaType String  @default("image")
  mediaPath String
  title     String?
  subtitle  String?
  link      String?
}

model CoverImage {
  id        Int     @id @default(autoincrement())
  imageName String
  imageType String?
  pageName  String
}

model SocialLink {
  id   Int     @id @default(autoincrement())
  url  String
  type Int
  name String?
}

model WhyUs {
  id              Int     @id @default(autoincrement())
  title           String
  description     String
  quote           String?
  fullDescription String?
  imageUrl        String?
}

model MediaCategory {
  id        Int     @id @default(autoincrement())
  title     String
  imageName String?
  media     Media[]
}

model Media {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  created     String?
  imageName   String?
  videoURl    String?
  mediaId     Int
  category    MediaCategory @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model FinishCategory {
  id          Int     @id @default(autoincrement())
  title       String
  imageName   String?
  description String?
  items       String?
}

model CommercialProject {
  id          Int     @id @default(autoincrement())
  title       String
  areaName    String
  description String
  imageName   String?
  unitsCount  Int     @default(0)
  type        String  @default("تجاري")
  priceStart  Float   @default(0)
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  project   String?
  message   String?
  createdAt DateTime @default(now())
  status    String   @default("جديد")
  notes     String?
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("SuperAdmin")
}

model LandingPage {
  id                     Int     @id @default(1)
  videoUrl               String? @default("https://www.youtube.com/embed/5oXlbsDoiPE")
  projectsCount          Int     @default(68)
  totalUnits             Int     @default(628)
  underConstructionCount Int     @default(90)
  deliveredUnitsCount    Int     @default(528)
}

